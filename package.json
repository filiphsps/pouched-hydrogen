{
  "name": "@pouched/gothenburg",
  "version": "0.1.0",
  "description": "A production-ready Shopify storefront built with Hydrogen and Weaverse",
  "keywords": [
    "shopify",
    "hydrogen",
    "theme",
    "hydrogen-theme",
    "weaverse",
    "ecommerce",
    "react",
    "react-router",
    "typescript",
    "tailwindcss"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "rm -rf dist .react-router playwright-report test-results coverage",
    "build": "shopify hydrogen build --codegen",
    "build:netlify": "DEPLOY_TARGET=netlify react-router build && DEPLOY_TARGET=netlify vite build --ssr app/entry.netlify.server.ts",
    "dev": "react-router typegen && shopify hydrogen dev --port 3456",
    "dev1": "react-router typegen && shopify hydrogen dev --codegen --port 3457",
    "dev:ca": "shopify hydrogen dev --codegen --port 3456 --customer-account-push",
    "preview": "shopify hydrogen preview --build",
    "start": "shopify hydrogen preview",
    "typecheck": "tsc --noEmit",
    "routes-check": "shopify hydrogen check routes",
    "codegen": "shopify hydrogen codegen",
    "hydrogen": "shopify hydrogen",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "pnpx playwright test",
    "e2e:ui": "pnpx playwright test --ui",
    "biome": "biome check",
    "biome:fix": "biome check --write --unsafe",
    "format": "biome format --write",
    "format:check": "biome format"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@radix-ui/react-visually-hidden": "1.2.4",
    "@shopify/hydrogen": "^2025.7.0",
    "@weaverse/hydrogen": "^5.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "colord": "2.9.3",
    "framer-motion": "12.23.24",
    "graphql": "16.12.0",
    "graphql-tag": "2.12.6",
    "i18next": "^25.6.3",
    "isbot": "5.1.32",
    "react": "19.2.1",
    "react-country-flag": "3.1.0",
    "react-dom": "19.2.1",
    "react-i18next": "^16.3.5",
    "react-intersection-observer": "10.0.0",
    "react-player": "2.16.0",
    "react-router": "7.9.2",
    "react-share": "5.2.2",
    "react-use": "17.6.0",
    "remix-i18next": "^7.4.2",
    "swiper": "^12.0.3",
    "tailwind-merge": "3.4.0",
    "tiny-invariant": "1.3.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.1.0",
    "@react-router/dev": "7.9.2",
    "@tailwindcss/vite": "^4.1.17",
    "schema-dts": "1.1.5",
    "@biomejs/biome": "^2.3.8",
    "@netlify/vite-plugin-react-router": "^2.1.2",
    "@playwright/test": "1.57.0",
    "@remix-run/dev": "^2.17.2",
    "@shopify/cli": "^3.88.0",
    "@shopify/hydrogen-codegen": "0.3.3",
    "@shopify/mini-oxygen": "^4.0.0",
    "@shopify/oxygen-workers-types": "4.2.0",
    "@tailwindcss/typography": "0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/react": "19.2.6",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@weaverse/biome": "5.6.2",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4.1.17",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "vite": "6.3.5",
      "react": "19.2.1",
      "react-dom": "19.2.1"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
