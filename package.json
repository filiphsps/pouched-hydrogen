{
    "name": "@pouched/gothenburg",
    "version": "0.1.0",
    "description": "A production-ready Shopify storefront built with Hydrogen and Weaverse",
    "packageManager": "pnpm@10.32.0",
    "keywords": [
        "shopify",
        "hydrogen",
        "theme",
        "hydrogen-theme",
        "weaverse",
        "ecommerce",
        "react",
        "react-router",
        "typescript",
        "tailwindcss"
    ],
    "license": "MIT",
    "type": "module",
    "scripts": {
        "clean": "rm -rf dist .react-router .netlify playwright-report test-results coverage",
        "build": "shopify hydrogen build --codegen",
        "build:netlify": "DEPLOY_TARGET=netlify react-router build && DEPLOY_TARGET=netlify vite build --ssr --mode netlify-edge",
        "dev": "react-router typegen && shopify hydrogen dev --port 3456",
        "dev1": "react-router typegen && shopify hydrogen dev --codegen --port 3457",
        "dev:ca": "shopify hydrogen dev --codegen --port 3456 --customer-account-push",
        "preview": "shopify hydrogen preview --build",
        "start": "shopify hydrogen preview",
        "codegen:typegen": "react-router typegen",
        "codegen:hydrogen": "shopify hydrogen codegen",
        "codegen": "npm-run-all --parallel codegen:typegen",
        "typecheck": "tsc --noEmit",
        "routes-check": "shopify hydrogen check routes",
        "hydrogen": "shopify hydrogen",
        "test": "vitest",
        "test:watch": "vitest watch",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest run --coverage",
        "e2e": "pnpx playwright test",
        "e2e:ui": "pnpx playwright test --ui",
        "biome:check": "biome check",
        "biome:format": "biome format",
        "biome:check:fix": "biome check --write --unsafe",
        "biome:format:fix": "biome format --write",
        "biome": "npm-run-all --parallel biome:check biome:format",
        "format": "npm-run-all --parallel biome:format:fix biome:check:fix"
    },
    "dependencies": {
        "@fontsource-variable/inter": "5.2.8",
        "@phosphor-icons/react": "2.1.10",
        "@radix-ui/react-accordion": "1.2.12",
        "@radix-ui/react-checkbox": "1.3.3",
        "@radix-ui/react-collapsible": "1.1.12",
        "@radix-ui/react-dialog": "1.1.15",
        "@radix-ui/react-dropdown-menu": "2.1.16",
        "@radix-ui/react-navigation-menu": "1.2.14",
        "@radix-ui/react-popover": "1.1.15",
        "@radix-ui/react-scroll-area": "1.2.10",
        "@radix-ui/react-select": "2.2.6",
        "@radix-ui/react-slider": "1.3.6",
        "@radix-ui/react-toggle-group": "1.1.11",
        "@radix-ui/react-tooltip": "1.2.8",
        "@radix-ui/react-visually-hidden": "1.2.4",
        "@shopify/hydrogen": "2026.1.0",
        "@weaverse/hydrogen": "5.9.0",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "colord": "2.9.3",
        "currency-symbol-map": "5.1.0",
        "date-holidays": "3.26.9",
        "framer-motion": "12.35.2",
        "graphql": "16.13.1",
        "graphql-tag": "2.12.6",
        "i18next": "25.8.17",
        "isbot": "5.1.35",
        "react": "19.2.4",
        "react-country-flag": "3.1.0",
        "react-dom": "19.2.4",
        "react-i18next": "16.5.6",
        "react-intersection-observer": "10.0.3",
        "react-player": "2.16.0",
        "react-router": "7.13.1",
        "react-share": "5.3.0",
        "react-use": "17.6.0",
        "remix-i18next": "7.4.2",
        "swiper": "12.1.2",
        "tailwind-merge": "3.5.0",
        "tiny-invariant": "1.3.3",
        "web-vitals": "5.1.0",
        "zustand": "5.0.11"
    },
    "devDependencies": {
        "@babel/preset-react": "7.28.5",
        "@babel/preset-typescript": "7.28.5",
        "@biomejs/biome": "2.4.6",
        "@graphql-codegen/cli": "6.1.3",
        "@netlify/vite-plugin-react-router": "3.0.0",
        "@playwright/test": "1.58.2",
        "@react-router/dev": "7.13.1",
        "@remix-run/dev": "2.17.4",
        "@shopify/cli": "3.91.1",
        "@shopify/hydrogen-codegen": "0.3.3",
        "@shopify/mini-oxygen": "4.0.1",
        "@shopify/oxygen-workers-types": "4.2.0",
        "@tailwindcss/typography": "0.5.19",
        "@tailwindcss/vite": "4.2.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "5.1.4",
        "@weaverse/biome": "5.7.3",
        "babel-plugin-react-compiler": "19.1.0-rc.3",
        "jsdom": "28.1.0",
        "npm-run-all2": "8.0.4",
        "schema-dts": "1.1.5",
        "tailwindcss": "4.2.1",
        "typescript": "5.9.3",
        "vite": "6.3.5",
        "vite-plugin-babel": "1.5.1",
        "vite-tsconfig-paths": "6.1.1",
        "vitest": "4.0.18"
    },
    "engines": {
        "node": ">=20"
    },
    "pnpm": {
        "overrides": {
            "vite": "6.3.5",
            "react": "19.2.4",
            "react-dom": "19.2.4"
        },
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "esbuild",
            "sharp",
            "workerd"
        ]
    }
}
